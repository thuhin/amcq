<?php
defined('BASEPATH') OR exit('No direct script access allowed');

/*
| -------------------------------------------------------------------
|  Per-server environment values
| -------------------------------------------------------------------
|
|  Copy this file to `env.php` (same directory) and fill in the values
|  for THIS server. `env.php` is gitignored and must never be copied
|  from one machine to another: it is the one file that differs between
|  localhost and production.
|
|  The tracked config files (config.php, database.php) only read these
|  constants, so uploading them can never point production at a dev
|  hostname or overwrite a credential.
|
|  Per-service credentials keep their own files next to this one:
|  payment.php (bKash/Nagad) and ai.php (OpenAI). Each has a .example twin.
*/

// ---- URLs ----------------------------------------------------------
define('APP_BASE_URL',  'http://amcqtest.com/');   // trailing slash
define('APP_ASSET_URL', 'http://amcqtest.com/asset/');

// ---- Sessions / cookies --------------------------------------------
define('APP_ENCRYPTION_KEY', '');   // 32 random chars; keep stable or sessions drop
define('APP_COOKIE_PREFIX',  '');   // e.g. 'amcq_' on prod, '' on localhost
define('APP_COOKIE_DOMAIN',  '');   // e.g. '.academicmcq.com' on prod, '' on localhost

// ---- Database ------------------------------------------------------
define('DB_HOSTNAME', '127.0.0.1');
define('DB_USERNAME', '');
define('DB_PASSWORD', '');
define('DB_DATABASE', 'amcq');

// ---- Environment ---------------------------------------------------
//  NOT set here. index.php reads $_SERVER['CI_ENV'], so the environment is
//  set by the web server, not by a tracked PHP file. In nginx:
//      fastcgi_param CI_ENV production;
//  Unset falls back to 'development'.

// ---- Money / safety rails ------------------------------------------
//  Leave OUT on production (defaults to TRUE in constants.php).
//  Set FALSE on any dev or staging machine so a stray call cannot
//  charge a real bKash wallet or hit a billable AI endpoint.
// define('ENABLE_LIVE_PAYMENTS', FALSE);
// define('ENABLE_AI_GENERATION', FALSE);
